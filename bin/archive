#!/usr/bin/env bash

set -e

die() {
	echo "$@" 1>&2
	exit 1
}

pack=0
unpack=0

if [ "$1" = pack ]; then
	pack=1
elif [ "$1" = unpack ]; then
	unpack=1
fi

if [ $pack -eq 0 ] && [ $unpack -eq 0 ]; then
	die missing action
fi

shift

if [ "$1" = "" ]; then
	die missing source file
fi

if [ $pack -eq 1 ]; then
	declare -a files

	for file in "$@"; do
		if [ -d "$file" ]; then
			LZIP=-9 tar --lzip -cf "$file.tar.lz" "$file"
			touch -r "$file" "$file.tar.lz"
			files+=("$file.tar.lz")
		else
			lzip -k9 "$file"
			files+=("$file.lz")
		fi
    done

	shasum -a 256 "${files[@]}" > "$1.sha256"
	files+=("$1.sha256")

	gpg --detach-sig --armor "$1.sha256"
	files+=("$1.sha256.asc")

	tar cf "$1.signed.tar" "${files[@]}"
	touch -r "$1" "$1.signed.tar"

	rm "${files[@]}"
else
	echo unpack
fi
